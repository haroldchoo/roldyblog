---
import type { CollectionEntry } from "astro:content";
import { formatDate, tagSlug, withBase } from "../lib/site";

interface Props {
  post: CollectionEntry<"posts">;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
---

<article class:list={["post-card", { featured }]}>
  <div>
    <time datetime={post.data.published.toISOString()}>{formatDate(post.data.published)}</time>
    <h2><a href={withBase(`/posts/${post.id}/`)}>{post.data.title}</a></h2>
    <p>{post.data.description}</p>
  </div>
  <ul class="tag-list" aria-label="Topics">
    {post.data.tags.map((tag) => (
      <li><a href={withBase(`/tags/${tagSlug(tag)}/`)}>#{tag}</a></li>
    ))}
  </ul>
</article>
