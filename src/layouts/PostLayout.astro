---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import Comments from "../components/Comments.astro";
import { formatDate, tagSlug, withBase } from "../lib/site";

interface Props {
  post: CollectionEntry<"posts">;
}

const { post } = Astro.props;
const { title, description, published, updated, tags } = post.data;
---

<BaseLayout title={title} description={description}>
  <article class="post shell">
    <header class="post-header">
      <p class="eyebrow">Field note</p>
      <h1>{title}</h1>
      <p class="dek">{description}</p>
      <div class="post-meta">
        <time datetime={published.toISOString()}>Published {formatDate(published)}</time>
        {updated && <time datetime={updated.toISOString()}>Updated {formatDate(updated)}</time>}
      </div>
      <ul class="tag-list" aria-label="Topics">
        {tags.map((tag) => <li><a href={withBase(`/tags/${tagSlug(tag)}/`)}>#{tag}</a></li>)}
      </ul>
    </header>
    <div class="prose">
      <slot />
    </div>
    <footer class="post-end">
      <p>That’s the state of it for now. I’ll update this note if the setup changes.</p>
      <a href={withBase("/posts/")}>← All writing</a>
    </footer>
    <Comments />
  </article>
</BaseLayout>
