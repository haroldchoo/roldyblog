---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import { tagSlug, withBase } from "../lib/site";

const posts = (await getCollection("posts", ({ data }) => !data.draft))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
const recent = posts.slice(0, 3);
const tagCounts = new Map<string, number>();
posts.flatMap((post) => post.data.tags).forEach((tag) => tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1));
const topics = [...tagCounts.entries()].sort((a, b) => b[1] - a[1]);
---

<BaseLayout>
  <section class="hero shell">
    <p class="eyebrow">A practical journal</p>
    <h1>Build it. Ride it.<br />Write down what worked.</h1>
    <p class="hero-copy">
      roldyblog follows the experience of running a small home server,
      untangling technology, and finding patterns in my cardio exercises.
    </p>
    <div class="hero-actions">
      <a class="button" href={withBase("/posts/")}>Read the notes</a>
      <a class="text-link" href={withBase("/about/")}>What this is about →</a>
    </div>
    <aside class="status-strip" aria-label="Current focus">
      <span>Current project</span>
      <strong>Plex Server</strong>
      <span class="status-dot">Online</span>
    </aside>
  </section>

  <section class="section shell">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Latest entries</p>
        <h2>Recently noted</h2>
      </div>
      <a href={withBase("/posts/")}>View the archive →</a>
    </div>
    <div class="post-grid">
      {recent.map((post, index) => <PostCard post={post} featured={index === 0} />)}
    </div>
  </section>

  <section class="topics-section">
    <div class="shell topics-layout">
      <div>
        <p class="eyebrow">Browse by curiosity</p>
        <h2>Topics</h2>
        <p>This started with a server. It won’t end there.</p>
      </div>
      <ul class="topic-list">
        {topics.map(([tag, count]) => (
          <li>
            <a href={withBase(`/tags/${tagSlug(tag)}/`)}>
              <span>{tag}</span><small>{count.toString().padStart(2, "0")}</small>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
